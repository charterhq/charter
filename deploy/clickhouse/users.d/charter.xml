<!--
  Query settings for the Charter run journal: no sampling profiler (its output went to
  trace_log, which config.d/charter.xml turns off). Mount into /etc/clickhouse-server/users.d/.
-->
<clickhouse>
    <profiles>
        <default>
            <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
            <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
            <memory_profiler_step>0</memory_profiler_step>
        </default>
    </profiles>
</clickhouse>
