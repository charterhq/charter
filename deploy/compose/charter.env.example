CHARTER_LISTEN=:8080
CHARTER_PUBLIC_URL=https://charter.example.com
CHARTER_BIFROST_URL=https://bifrost.example.com
CHARTER_MODEL_CLASSES={"reasoning-light":"lf-default"}
CHARTER_MODEL_PARAMS={"reasoning-light":{"max_tokens":16384,"temperature":0.2}}
CHARTER_MM_URL=https://mm.example.com
CHARTER_MM_DEFAULT_CHANNEL=
CHARTER_CH_URL=http://clickhouse.example.com:8123
CHARTER_CH_USER=charter
CHARTER_CH_DATABASE=agentic
# Tools through an MCP gateway: per-agent gateway keys, "*" for agents without their own.
CHARTER_MCP_URL=https://mcp.example.com/mcp
# CHARTER_MCP_KEYS_FILE=/run/secrets/mcp_keys   # agent:key,agent2:key2,*:default-key
# Time zone of schedule triggers without CRON_TZ (UTC by default).
# CHARTER_SCHEDULE_TZ=Europe/Moscow
