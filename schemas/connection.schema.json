{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charter.dev/schemas/v1/connection.schema.json",
  "title": "Charter connection",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "charter.dev/v1"},
    "kind": {"const": "Connection"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "team", "owner"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "scenarios", "status"],
      "properties": {
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "versions"],
          "properties": {"name": {"type": "string"}, "versions": {"type": "string"}}
        },
        "scenarios": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "triggers": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "receiver": {"enum": ["alertmanager", "raw"]},
              "schedule": {"type": "string", "minLength": 1},
              "input": {"type": "object"}
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "params": {"type": "object"},
        "knowledge": {"type": "array"},
        "budgets": {"type": "object"},
        "status": {"enum": ["shadow", "active", "paused"]}
      }
    }
  }
}
